:root{
  --pit-black:#0b0b0b;
  --bone:#f2efe6;
  --ash:#c8c0b4;
  --smoke:#78736d;
  --bourbon:#ad7132;
  --line:rgba(242,239,230,.16);
}
*{box-sizing:border-box}
html{background:var(--pit-black);scroll-behavior:smooth}
body{
  margin:0;
  background:
    radial-gradient(circle at top,rgba(173,113,50,.09),transparent 32%),
    var(--pit-black);
  color:var(--bone);
  font-family:Inter,sans-serif;
}
.charter-hero{
  width:min(900px,100%);
  margin:0 auto;
  padding:3rem 1.25rem 5rem;
  text-align:center;
}
.back-link{
  display:block;
  margin-bottom:4rem;
  color:var(--smoke);
  text-decoration:none;
  font-size:.72rem;
  letter-spacing:.15em;
  text-transform:uppercase;
}
.kicker{
  margin:0 0 .75rem;
  color:var(--bourbon);
  font-size:.72rem;
  font-weight:600;
  letter-spacing:.28em;
  text-transform:uppercase;
}
h1,h2{
  margin:0;
  font-family:"Cormorant Garamond",serif;
}
h1{
  font-size:clamp(4.2rem,16vw,8rem);
  line-height:.92;
}
.intro{
  margin:1.25rem 0 0;
  color:var(--ash);
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(1.35rem,4vw,2rem);
}
.charter-list{
  width:min(900px,100%);
  margin:0 auto;
  padding:0 1.25rem;
  border-top:1px solid var(--line);
}
.charter-list article{
  display:grid;
  grid-template-columns:64px 1fr;
  gap:1.25rem;
  padding:2.25rem 0;
  border-bottom:1px solid var(--line);
}
.charter-list article>span{
  color:var(--bourbon);
  font-family:"Cormorant Garamond",serif;
  font-size:1.4rem;
}
.charter-list h2{
  font-size:clamp(2rem,7vw,3.3rem);
  line-height:1;
}
.charter-list p{
  max-width:650px;
  margin:1rem 0 0;
  color:var(--ash);
  line-height:1.75;
}
.closing{
  padding:6rem 1.25rem 7rem;
  text-align:center;
}
.closing p{
  margin:.15rem 0;
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(2.3rem,8vw,4.5rem);
  line-height:1;
}
.closing p:last-child{color:var(--bourbon)}
@media(max-width:520px){
  .charter-hero{padding-top:2rem}
  .charter-list article{grid-template-columns:42px 1fr;gap:.85rem}
}
